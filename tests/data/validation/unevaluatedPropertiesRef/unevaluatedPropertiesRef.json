{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$defs": {
    "Extra": {
      "type": "object",
      "properties": {
        "n": {"type": "number"}
      },
      "required": ["n"]
    }
  },
  "type": "object",
  "properties": {
    "known": { "type": "string" }
  },
  "patternProperties": {
    "^p_": { "type": "integer" }
  },
  "required": ["known"],
  "unevaluatedProperties": { "$ref": "#/$defs/Extra" }
}

